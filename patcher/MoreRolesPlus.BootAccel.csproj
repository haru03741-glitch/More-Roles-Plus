<Project Sdk="Microsoft.NET.Sdk">
    <!-- 起動を速くする BepInEx の patcher (BepInEx-MRP/patchers に置く単体 DLL)。
         AmongUsPath は ../local.props で上書きする。 -->
    <PropertyGroup>
        <AmongUsPath>C:\Program Files\Epic Games\AmongUs</AmongUsPath>
    </PropertyGroup>
    <Import Project="..\local.props" Condition="Exists('..\local.props')" />

    <PropertyGroup>
        <TargetFramework>net6.0</TargetFramework>
        <LangVersion>latest</LangVersion>
        <Nullable>disable</Nullable>
        <AssemblyName>MoreRolesPlus.BootAccel</AssemblyName>
        <RootNamespace>MoreRolesPlus.BootAccel</RootNamespace>
        <Description>More Roles Plus Boot Accelerator</Description>
        <Platforms>AnyCPU</Platforms>
        <Configurations>Debug;Release</Configurations>
        <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
        <!-- 参照するアセンブリは全部ローダー側にあるので、出力へは自分の DLL だけを出す -->
        <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
        <GenerateDependencyFile>false</GenerateDependencyFile>
        <ProduceReferenceAssembly>false</ProduceReferenceAssembly>
        <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
        <DebugType>portable</DebugType>
        <Deterministic>true</Deterministic>
        <AssemblyVersion>1.0.0.0</AssemblyVersion>
        <FileVersion>1.0.0.0</FileVersion>
        <MrpBepInExDir>$(AmongUsPath)\BepInEx-MRP</MrpBepInExDir>
    </PropertyGroup>
    <!-- BepInEx-MRP が無い時は、MRP が普通の BepInEx に入っているゲーム (Steam 版など) の core を参照する -->
    <PropertyGroup Condition="!Exists('$(MrpBepInExDir)\core\BepInEx.Preloader.Core.dll')">
        <MrpBepInExDir Condition="'$(MrpExtraGamePaths)' != '' And Exists('$(MrpExtraGamePaths)\BepInEx\core\BepInEx.Preloader.Core.dll')">$(MrpExtraGamePaths)\BepInEx</MrpBepInExDir>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="BepInEx.Core" Version="6.0.0-be.735" Private="false" ExcludeAssets="runtime;native" />
        <PackageReference Include="BepInEx.Unity.IL2CPP" Version="6.0.0-be.735" Private="false" ExcludeAssets="runtime;native" />
        <PackageReference Include="HarmonyX" Version="2.10.2" Private="false" ExcludeAssets="runtime;native" />
    </ItemGroup>

    <ItemGroup>
        <!-- BepInEx.Preloader.Core は NuGet に無いので、ゲームに置いた BepInEx の core から参照する -->
        <Reference Include="BepInEx.Preloader.Core">
            <HintPath>$(MrpBepInExDir)\core\BepInEx.Preloader.Core.dll</HintPath>
            <Private>false</Private>
        </Reference>
    </ItemGroup>

    <Target Name="ValidateLoader" BeforeTargets="BeforeBuild;ResolveAssemblyReferences">
        <Error Condition="!Exists('$(MrpBepInExDir)\core\BepInEx.Preloader.Core.dll')"
               Text="'$(MrpBepInExDir)\core\BepInEx.Preloader.Core.dll' が見つかりません。local.props の AmongUsPath を BepInEx-MRP を置いた Among Us のフォルダに合わせてください。" />
    </Target>

    <!-- 配置先は本体と同じ (AmongUsPath と MrpExtraGamePaths・BepInEx-MRP\core が無い所は飛ばす) -->
    <Target Name="CopyToGame" AfterTargets="Build" Condition="'$(MrpNoDeploy)' != 'true'">
        <ItemGroup>
            <_MrpGameRoot Include="$(AmongUsPath);$(MrpExtraGamePaths)" />
            <_MrpRootMrp Include="@(_MrpGameRoot)" Condition="Exists('%(Identity)\BepInEx-MRP\core')" />
            <_MrpRootPlain Include="@(_MrpGameRoot)" Condition="!Exists('%(Identity)\BepInEx-MRP\core') And Exists('%(Identity)\BepInEx\plugins\MoreRolesPlus.dll')" />
            <_MrpPatcherDir Include="@(_MrpRootMrp->'%(Identity)\BepInEx-MRP\patchers')" />
            <_MrpPatcherDir Include="@(_MrpRootPlain->'%(Identity)\BepInEx\patchers')" />
        </ItemGroup>
        <RemoveDuplicates Inputs="@(_MrpPatcherDir)">
            <Output TaskParameter="Filtered" ItemName="_MrpPatcherDirUnique" />
        </RemoveDuplicates>
        <MakeDir Directories="@(_MrpPatcherDirUnique)" />
        <Copy SourceFiles="$(OutputPath)$(AssemblyName).dll" DestinationFolder="%(_MrpPatcherDirUnique.Identity)\" ContinueOnError="WarnAndContinue" Condition="'@(_MrpPatcherDirUnique)' != ''" />
        <Message Importance="high" Text="配置済み (patcher): %(_MrpPatcherDirUnique.Identity)" Condition="'@(_MrpPatcherDirUnique)' != ''" />
    </Target>
</Project>
