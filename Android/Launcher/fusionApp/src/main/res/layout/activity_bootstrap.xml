<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/bootstrap_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:background="@color/ek_soot"
    android:padding="24dp">

    <dev.allofus.fusioncore.ui.EmberView
        android:id="@+id/bootstrap_progress"
        android:layout_width="96dp"
        android:layout_height="96dp"
        android:importantForAccessibility="no" />

    <ProgressBar
        android:id="@+id/bootstrap_download_progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:max="100"
        android:indeterminate="false"
        android:progress="0"
        android:progressTint="@color/ek_ember"
        android:progressBackgroundTint="@color/ek_ash_line"
        android:visibility="gone" />

    <TextView
        android:id="@+id/bootstrap_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center"
        android:text="@string/bootstrap_title"
        android:textColor="@color/ek_afterglow"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/bootstrap_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:text="@string/bootstrap_status_preparing"
        android:textColor="@color/ek_slate"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/bootstrap_progress_details"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center"
        android:textColor="@color/ek_slate"
        android:textSize="12sp"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/bootstrap_actions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:visibility="gone">

        <Button
            android:id="@+id/bootstrap_action_update"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:text="@string/bootstrap_action_get_update" />

        <Button
            android:id="@+id/bootstrap_action_share_logs"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="@string/home_action_share_logs" />
    </LinearLayout>

</LinearLayout>
