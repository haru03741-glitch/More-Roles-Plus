<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Launcher" parent="Theme.Material3.Dark.NoActionBar">
        <item name="android:windowBackground">@color/lc_soot</item>
        <item name="android:colorBackground">@color/lc_soot</item>
        <item name="android:textColorPrimary">@color/lc_afterglow</item>
        <item name="android:textColorSecondary">@color/lc_slate</item>
        <item name="android:statusBarColor">@color/lc_soot</item>
        <item name="android:navigationBarColor">@color/lc_soot</item>

        <item name="colorPrimary">@color/lc_ember</item>
        <item name="colorOnPrimary">@color/lc_soot</item>
        <item name="colorPrimaryContainer">@color/lc_ember_dim</item>
        <item name="colorOnPrimaryContainer">@color/lc_afterglow</item>
        <item name="colorSecondary">@color/lc_slate</item>
        <item name="colorOnSecondary">@color/lc_soot</item>
        <item name="colorSecondaryContainer">@color/lc_ash_raised</item>
        <item name="colorOnSecondaryContainer">@color/lc_afterglow</item>
        <item name="colorTertiary">@color/lc_slate</item>

        <item name="colorSurface">@color/lc_soot</item>
        <item name="colorOnSurface">@color/lc_afterglow</item>
        <item name="colorOnSurfaceVariant">@color/lc_slate</item>
        <item name="colorSurfaceContainerLowest">@color/lc_soot</item>
        <item name="colorSurfaceContainerLow">@color/lc_ash</item>
        <item name="colorSurfaceContainer">@color/lc_ash</item>
        <item name="colorSurfaceContainerHigh">@color/lc_ash_raised</item>
        <item name="colorSurfaceContainerHighest">@color/lc_ash_raised</item>
        <item name="colorOutline">@color/lc_cinder</item>
        <item name="colorOutlineVariant">@color/lc_ash_line</item>
        <item name="colorError">@color/lc_error</item>
        <item name="colorOnError">@color/lc_soot</item>

        <item name="materialButtonOutlinedStyle">@style/Widget.Launcher.Button.Outlined</item>
    </style>

    <style name="Widget.Launcher.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:textColor">@color/lc_afterglow</item>
        <item name="strokeColor">@color/lc_cinder</item>
        <item name="shapeAppearance">@style/ShapeAppearance.Launcher.Small</item>
        <item name="android:minHeight">52dp</item>
    </style>

    <style name="Widget.Launcher.Button.Text" parent="Widget.Material3.Button.TextButton">
        <item name="android:textColor">@color/lc_ember</item>
    </style>

    <style name="ShapeAppearance.Launcher.Small" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">10dp</item>
    </style>

    <!-- Status readout: label left, monospaced value right. -->
    <style name="TextAppearance.Launcher.Label" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:textColor">@color/lc_slate</item>
    </style>

    <style name="TextAppearance.Launcher.Readout" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:fontFamily">monospace</item>
        <item name="android:textColor">@color/lc_afterglow</item>
        <item name="android:letterSpacing">0.02</item>
    </style>
</resources>
