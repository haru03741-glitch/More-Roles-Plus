<Project Sdk="Microsoft.NET.Sdk">
    <!-- More Roles Plus のインストーラー (1 つの .exe)。
         .NET Framework 4.8 の WPF なので、Windows 10/11 なら何も足さずに動く。
         BepInEx 一式と MRP の DLL は Payload.zip にまとめて exe の中へ埋め込む (ビルドの時に作る)。
         作り方: dotnet build installer/MrpInstaller/MrpInstaller.csproj -c Release
         → installer/MrpInstaller/bin/Release/MoreRolesPlusInstaller.exe -->
    <Import Project="..\..\local.props" Condition="Exists('..\..\local.props')" />

    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net48</TargetFramework>
        <UseWPF>true</UseWPF>
        <LangVersion>latest</LangVersion>
        <Nullable>disable</Nullable>
        <AssemblyName>MoreRolesPlusInstaller</AssemblyName>
        <RootNamespace>MrpInstaller</RootNamespace>
        <ApplicationManifest>app.manifest</ApplicationManifest>
        <ApplicationIcon>mrp.ico</ApplicationIcon>
        <Product>More Roles Plus Installer</Product>
        <Copyright>GPL-3.0</Copyright>
        <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
        <GenerateDocumentationFile>false</GenerateDocumentationFile>
        <MrpRepo>$(MSBuildThisFileDirectory)..\..\</MrpRepo>
        <!-- 中身は installer/make-payload.ps1 が組んだフォルダ (公式の BepInEx と packaging/ と MRP のビルド出力) -->
        <MrpPayloadDir>$(MSBuildThisFileDirectory)obj\mrp-payload\</MrpPayloadDir>
        <MrpPayloadZip>$(MSBuildThisFileDirectory)obj\Payload.zip</MrpPayloadZip>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
        <Reference Include="System.IO.Compression" />
        <Reference Include="System.IO.Compression.FileSystem" />
        <Reference Include="System.Net.Http" />
        <Reference Include="System.Web" />
        <Reference Include="System.Web.Extensions" />
        <Reference Include="System.Windows.Forms" />
    </ItemGroup>

    <ItemGroup>
        <Resource Include="mrp.png" />
        <Resource Include="mrp-art.jpg" />
    </ItemGroup>

    <!-- 埋め込む中身を zip にする。中身は先に installer/make-payload.ps1 で組んでおく -->
    <Target Name="MrpPayload" BeforeTargets="PrepareForBuild" Condition="'$(DesignTimeBuild)' != 'true'">
        <Error Condition="!Exists('$(MrpPayloadDir)BepInEx\plugins\MoreRolesPlus.dll')" Text="インストーラーの中身が無い: $(MrpPayloadDir) (先に powershell -File installer/make-payload.ps1)" />
        <Delete Files="$(MrpPayloadZip)" />
        <ZipDirectory SourceDirectory="$(MrpPayloadDir)" DestinationFile="$(MrpPayloadZip)" Overwrite="true" />
        <ItemGroup>
            <EmbeddedResource Include="$(MrpPayloadZip)" LogicalName="MrpInstaller.Payload.zip" />
        </ItemGroup>
        <Message Importance="high" Text="インストーラーの中身: $(MrpPayloadZip)" />
    </Target>
    <!-- インストーラーの版も MRP と同じ (src/Plugin.cs の Version)。自分の更新はこれとリリースのタグで決める -->
    <Target Name="MrpVersionFromPlugin" BeforeTargets="GetAssemblyVersion;GenerateAssemblyInfo">
        <PropertyGroup>
            <_MrpPluginSrc>$([System.IO.File]::ReadAllText('$(MrpRepo)src/Plugin.cs'))</_MrpPluginSrc>
            <Version>$([System.Text.RegularExpressions.Regex]::Match($(_MrpPluginSrc), 'const string Version = "([0-9.]+)"').Groups[1].Value)</Version>
            <FileVersion>$(Version)</FileVersion>
            <AssemblyVersion>$(Version)</AssemblyVersion>
            <InformationalVersion>$(Version)</InformationalVersion>
        </PropertyGroup>
    </Target>
</Project>
