<Window x:Class="MrpInstaller.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="More Roles Plus Installer" Width="1080" Height="700" MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterScreen" Background="{StaticResource Bg}" WindowStyle="None" ResizeMode="CanResize"
        Foreground="{StaticResource Text}" FontFamily="{StaticResource UiFont}"
        Icon="/mrp.png" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Grid x:Name="Root">
      <Grid x:Name="Shell" RenderTransformOrigin="0.5,0.5">
        <Grid.RenderTransform>
            <ScaleTransform x:Name="ShellScale" />
        </Grid.RenderTransform>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- 左のメニュー -->
        <Border x:Name="SidePane" Background="{StaticResource Side}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="18,20,18,18">
                    <Border Width="72" Height="72" CornerRadius="16" HorizontalAlignment="Left">
                        <Border.Background>
                            <ImageBrush ImageSource="/mrp.png" Stretch="UniformToFill" />
                        </Border.Background>
                        <Border.Effect>
                            <DropShadowEffect x:Name="LogoGlow" BlurRadius="20" ShadowDepth="0" Opacity="0.5" Color="#FF00E676" />
                        </Border.Effect>
                    </Border>
                    <TextBlock Text="More Roles Plus" FontSize="19" FontWeight="Bold" Margin="0,14,0,2" />
                    <TextBlock Tag="L:app.subtitle" Style="{StaticResource Hint}" />
                </StackPanel>
                <StackPanel DockPanel.Dock="Bottom" Margin="18,0,18,16">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <Button x:Name="LangJa" Content="日本語" Style="{StaticResource Ghost}" Click="LangJa_Click" Margin="0,0,6,0" ToolTip="L:tip.lang" />
                        <Button x:Name="LangEn" Content="English" Style="{StaticResource Ghost}" Click="LangEn_Click" ToolTip="L:tip.lang" />
                    </StackPanel>
                    <TextBlock x:Name="SideVersion" Style="{StaticResource Hint}" FontSize="11" />
                </StackPanel>
                <StackPanel Margin="0,6,0,0">
                    <RadioButton x:Name="NavHome" Style="{StaticResource Nav}" Tag="&#xE80F;" IsChecked="True" Checked="Nav_Checked" ToolTip="L:tip.navHome"><TextBlock Tag="L:nav.home" /></RadioButton>
                    <RadioButton x:Name="NavTools" Style="{StaticResource Nav}" Tag="&#xE90F;" Checked="Nav_Checked" ToolTip="L:tip.navTools"><TextBlock Tag="L:nav.tools" /></RadioButton>
                    <RadioButton x:Name="NavBackups" Style="{StaticResource Nav}" Tag="&#xE81C;" Checked="Nav_Checked" ToolTip="L:tip.navBackups"><TextBlock Tag="L:nav.backups" /></RadioButton>
                    <RadioButton x:Name="NavSettings" Style="{StaticResource Nav}" Tag="&#xE713;" Checked="Nav_Checked" ToolTip="L:tip.navSettings"><TextBlock Tag="L:nav.settings" /></RadioButton>
                    <RadioButton x:Name="NavAbout" Style="{StaticResource Nav}" Tag="&#xE946;" Checked="Nav_Checked" ToolTip="L:tip.navAbout">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Tag="L:nav.about" />
                            <Ellipse x:Name="UpdateDot" Width="8" Height="8" Fill="{StaticResource Accent}" Margin="8,0,0,0" VerticalAlignment="Center" Visibility="Collapsed" />
                        </StackPanel>
                    </RadioButton>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="40" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- タイトルバー -->
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                    <Button x:Name="HelpBtn" Style="{StaticResource Caption}" Click="Help_Click" ToolTip="L:tip.help"><TextBlock Text="&#xE897;" FontFamily="{StaticResource IconFont}" FontSize="13" /></Button>
                    <Button Style="{StaticResource Caption}" Click="Min_Click"><TextBlock Text="&#xE921;" FontFamily="{StaticResource IconFont}" FontSize="10" /></Button>
                    <Button Style="{StaticResource Caption}" Click="Max_Click"><TextBlock x:Name="MaxGlyph" Text="&#xE922;" FontFamily="{StaticResource IconFont}" FontSize="10" /></Button>
                    <Button Style="{StaticResource CaptionClose}" Click="Close_Click"><TextBlock Text="&#xE8BB;" FontFamily="{StaticResource IconFont}" FontSize="10" /></Button>
                </StackPanel>
                <TextBlock x:Name="PageTitle" Margin="28,12,0,0" FontSize="12" Foreground="{StaticResource Sub}" />
            </DockPanel>

            <Grid x:Name="Pages" Grid.Row="1">
            <!-- ホーム -->
            <Grid x:Name="PageHome" Margin="28,0,28,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <!-- 絵の帯 (右に絵、左へ向かって暗く) -->
                <Border x:Name="Banner" CornerRadius="14" Height="132" Margin="0,0,0,14" ClipToBounds="True" Background="#FF161B22">
                    <Grid>
                        <Border Width="420" HorizontalAlignment="Right" CornerRadius="0,14,14,0">
                            <Border.Background>
                                <ImageBrush ImageSource="/mrp-art.jpg" Stretch="UniformToFill" Viewbox="0,0.03,1,0.47" ViewboxUnits="RelativeToBoundingBox" />
                            </Border.Background>
                        </Border>
                        <Border CornerRadius="14">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#FF161B22" Offset="0" />
                                    <GradientStop Color="#FF161B22" Offset="0.38" />
                                    <GradientStop Color="#66161B22" Offset="0.7" />
                                    <GradientStop Color="#00161B22" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                        <Border Height="3" VerticalAlignment="Bottom" Background="{StaticResource BrandGrad}" Opacity="0.85" />
                        <StackPanel VerticalAlignment="Center" Margin="26,0">
                            <TextBlock Text="More Roles Plus" FontSize="30" FontWeight="Black">
                                <TextBlock.Foreground>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#FF00E676" Offset="0" />
                                        <GradientStop Color="#FF69F0AE" Offset="0.6" />
                                        <GradientStop Color="#FFB9F6CA" Offset="1" />
                                    </LinearGradientBrush>
                                </TextBlock.Foreground>
                            </TextBlock>
                            <TextBlock x:Name="BannerSub" FontSize="13" Foreground="#FFCED8D3" Margin="2,4,0,0" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 新しい版のお知らせ -->
                <Border x:Name="UpdateBanner" Grid.Row="1" Background="#1A00E676" BorderBrush="#8000E676" BorderThickness="1" CornerRadius="10" Padding="16,10" Margin="0,0,0,14" Visibility="Collapsed">
                    <DockPanel>
                        <Button x:Name="UpdateBannerBtn" DockPanel.Dock="Right" Style="{StaticResource Primary}" FontSize="13" Padding="18,8" Click="UpdateBanner_Click" ToolTip="L:tip.updateBanner">
                            <TextBlock Tag="L:upd.now" />
                        </Button>
                        <Button DockPanel.Dock="Right" Style="{StaticResource Ghost}" Foreground="{StaticResource Sub}" Click="UpdateLater_Click" Margin="0,0,8,0" ToolTip="L:tip.later">
                            <TextBlock Tag="L:upd.later" />
                        </Button>
                        <TextBlock Text="&#xE896;" FontFamily="{StaticResource IconFont}" FontSize="18" Foreground="{StaticResource Accent}" VerticalAlignment="Center" Margin="0,0,12,0" />
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="UpdateBannerTitle" FontWeight="Bold" FontSize="14" />
                            <TextBlock x:Name="UpdateBannerSub" Style="{StaticResource Hint}" />
                        </StackPanel>
                    </DockPanel>
                </Border>

                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="300" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <DockPanel x:Name="GamesPane">
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                            <Button DockPanel.Dock="Right" Style="{StaticResource Ghost}" Click="Rescan_Click" ToolTip="L:tip.rescan">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE72C;" FontFamily="{StaticResource IconFont}" Margin="0,0,6,0" VerticalAlignment="Center" />
                                    <TextBlock Tag="L:home.rescan" />
                                </StackPanel>
                            </Button>
                            <TextBlock Tag="L:home.games" Style="{StaticResource H2}" Margin="0" VerticalAlignment="Center" />
                        </DockPanel>
                        <Button x:Name="AddFolderBtn" DockPanel.Dock="Bottom" Click="AddFolder_Click" Margin="0,4,0,12" Background="Transparent" ToolTip="L:tip.addFolder">
                            <TextBlock Tag="L:home.addFolder" />
                        </Button>
                        <Grid>
                            <ListBox x:Name="Games" Style="{StaticResource GameList}" SelectionChanged="Games_SelectionChanged">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid ToolTip="{Binding Tip}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Border Width="38" Height="38" CornerRadius="9" Background="{Binding PlatformBrush}" VerticalAlignment="Top">
                                                <TextBlock Text="{Binding PlatformShort}" FontWeight="Black" FontSize="13" Foreground="{Binding PlatformFg}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="14" />
                                                <TextBlock Text="{Binding Path}" Style="{StaticResource Hint}" FontSize="11" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Margin="0,1,0,6" />
                                                <Border Style="{StaticResource Pill}" Background="{Binding StateBg}">
                                                    <TextBlock Text="{Binding StateText}" FontSize="11" FontWeight="SemiBold" Foreground="{Binding StateFg}" />
                                                </Border>
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <TextBlock x:Name="NoGames" Tag="L:home.noGame" Style="{StaticResource Hint}" Margin="4,10" Visibility="Collapsed" />
                        </Grid>
                    </DockPanel>

                    <!-- 選んだゲームの詳しい所 -->
                    <Border x:Name="DetailCard" Grid.Column="2" Style="{StaticResource CardBox}" Margin="0,0,0,12" Padding="22,20">
                        <Grid>
                            <TextBlock x:Name="NoSelection" Tag="L:home.select" Style="{StaticResource Hint}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="14" />
                            <DockPanel x:Name="Detail" Visibility="Collapsed">
                                <DockPanel.RenderTransform>
                                    <TranslateTransform x:Name="DetailShift" />
                                </DockPanel.RenderTransform>
                                <StackPanel DockPanel.Dock="Top">
                                    <DockPanel>
                                        <Border x:Name="DStateBox" DockPanel.Dock="Right" Style="{StaticResource Pill}" VerticalAlignment="Top" Padding="12,5" CornerRadius="12" ToolTip="L:tip.state">
                                            <TextBlock x:Name="DState" FontWeight="Bold" FontSize="12" />
                                        </Border>
                                        <TextBlock x:Name="DTitle" Style="{StaticResource H1}" />
                                    </DockPanel>
                                    <TextBlock x:Name="DPath" Style="{StaticResource Hint}" Margin="0,0,0,12" Cursor="Hand" MouseLeftButtonUp="DPath_Click" TextDecorations="Underline" ToolTip="L:tip.path" />
                                    <Border x:Name="WarnBox" Background="#22FFD23F" BorderBrush="#66FFD23F" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,0,0,12" Visibility="Collapsed">
                                        <TextBlock x:Name="WarnText" Foreground="{StaticResource Yellow}" FontSize="12" />
                                    </Border>
                                    <Grid x:Name="InfoGrid" Margin="0,0,0,16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="150" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Tag="L:home.mrp" Style="{StaticResource Hint}" Margin="0,4" ToolTip="L:tip.iMrp" />
                                        <TextBlock x:Name="IMrp" Grid.Column="1" Margin="0,4" FontSize="13" />
                                        <TextBlock Grid.Row="1" Tag="L:home.payload" Style="{StaticResource Hint}" Margin="0,4" ToolTip="L:tip.iPayload" />
                                        <TextBlock x:Name="IPayload" Grid.Row="1" Grid.Column="1" Margin="0,4" FontSize="13" />
                                        <TextBlock Grid.Row="2" Tag="L:home.bootaccel" Style="{StaticResource Hint}" Margin="0,4" ToolTip="L:tip.iAccel" />
                                        <TextBlock x:Name="IAccel" Grid.Row="2" Grid.Column="1" Margin="0,4" FontSize="13" />
                                        <TextBlock Grid.Row="3" Tag="L:home.others" Style="{StaticResource Hint}" Margin="0,4" ToolTip="L:tip.iOthers" />
                                        <TextBlock x:Name="IOthers" Grid.Row="3" Grid.Column="1" Margin="0,4" FontSize="13" />
                                        <TextBlock Grid.Row="4" Tag="L:home.gameUpdated" Style="{StaticResource Hint}" Margin="0,4" ToolTip="L:tip.iGame" />
                                        <TextBlock x:Name="IGame" Grid.Row="4" Grid.Column="1" Margin="0,4" FontSize="13" />
                                    </Grid>
                                    <WrapPanel x:Name="MainActions" Margin="0,0,0,4">
                                        <Button x:Name="BtnInstall" Style="{StaticResource Primary}" Click="Install_Click" Margin="0,0,10,10" MinWidth="150" ToolTip="L:tip.install">
                                            <TextBlock x:Name="BtnInstallText" />
                                        </Button>
                                        <Button x:Name="BtnLaunch" Style="{StaticResource Play}" Click="Launch_Click" Margin="0,0,10,10" MinWidth="130" ToolTip="L:tip.launch">
                                            <TextBlock Tag="L:home.launch" />
                                        </Button>
                                    </WrapPanel>
                                    <WrapPanel x:Name="SubActions">
                                        <Button x:Name="BtnToggle" Click="Toggle_Click" Margin="0,0,8,8" ToolTip="L:tip.toggle"><TextBlock x:Name="BtnToggleText" /></Button>
                                        <Button x:Name="BtnUninstall" Style="{StaticResource Danger}" Click="Uninstall_Click" Margin="0,0,8,8" ToolTip="L:tip.uninstall">
                                            <TextBlock Tag="L:home.uninstall" />
                                        </Button>
                                        <Button x:Name="BtnRemove" Style="{StaticResource Ghost}" Click="RemoveFolder_Click" Margin="0,0,8,8" Foreground="{StaticResource Sub}" ToolTip="L:tip.removeFolder">
                                            <TextBlock Tag="L:home.removeFolder" />
                                        </Button>
                                    </WrapPanel>
                                </StackPanel>
                                <Border x:Name="LogBox" Background="#FF12161C" CornerRadius="8" Padding="10,8" Margin="0,8,0,0" ToolTip="L:tip.logBox">
                                    <ListBox x:Name="LogList" Background="Transparent" BorderThickness="0" Foreground="{StaticResource Sub}" FontFamily="Consolas, Yu Gothic UI" FontSize="11.5"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                        <ListBox.ItemContainerStyle>
                                            <Style TargetType="ListBoxItem">
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="ListBoxItem">
                                                            <ContentPresenter Margin="0,1" />
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </ListBox.ItemContainerStyle>
                                    </ListBox>
                                </Border>
                            </DockPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>

            <!-- ツール -->
            <ScrollViewer x:Name="PageTools" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="28,0,28,20">
                    <TextBlock Tag="L:tools.title" Style="{StaticResource H1}" />
                    <TextBlock x:Name="ToolsTarget" Style="{StaticResource Hint}" Margin="0,0,0,16" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource CardBox}">
                            <StackPanel>
                                <TextBlock Tag="L:tools.folders" Style="{StaticResource H2}" />
                                <Button Style="{StaticResource ToolBtn}" Click="OpenGame_Click" ToolTip="L:tip.openGame"><TextBlock Tag="L:tools.openGame" /></Button>
                                <Button Style="{StaticResource ToolBtn}" Click="OpenPlugins_Click" ToolTip="L:tip.openPlugins"><TextBlock Tag="L:tools.openPlugins" /></Button>
                                <Button Style="{StaticResource ToolBtn}" Click="OpenConfig_Click" ToolTip="L:tip.openConfig"><TextBlock Tag="L:tools.openConfig" /></Button>
                                <Button Style="{StaticResource ToolBtn}" Click="OpenLang_Click" ToolTip="L:tip.openLang"><TextBlock Tag="L:tools.openLang" /></Button>
                                <Button Style="{StaticResource ToolBtn}" Click="OpenLog_Click" Margin="0" ToolTip="L:tip.openLog"><TextBlock Tag="L:tools.openLog" /></Button>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="2" Style="{StaticResource CardBox}">
                            <StackPanel>
                                <TextBlock Tag="L:tools.fix" Style="{StaticResource H2}" />
                                <Button Style="{StaticResource ToolBtn}" Click="ClearCache_Click" Margin="0,0,0,2" ToolTip="L:tip.clearCache"><TextBlock Tag="L:tools.clearCache" /></Button>
                                <TextBlock Tag="L:tools.clearCacheHint" Style="{StaticResource Hint}" Margin="2,0,0,10" />
                                <Button Style="{StaticResource ToolBtn}" Click="Diag_Click" Margin="0,0,0,2" ToolTip="L:tip.diag"><TextBlock Tag="L:tools.diag" /></Button>
                                <TextBlock Tag="L:tools.diagHint" Style="{StaticResource Hint}" Margin="2,0,0,10" />
                                <Button Style="{StaticResource ToolBtn}" Click="Shortcut_Click" ToolTip="L:tip.shortcut"><TextBlock Tag="L:tools.shortcut" /></Button>
                                <Button Style="{StaticResource ToolBtn}" Click="Copy_Click" Margin="0,0,0,2" ToolTip="L:tip.copy"><TextBlock Tag="L:tools.copy" /></Button>
                                <TextBlock Tag="L:tools.copyHint" Style="{StaticResource Hint}" Margin="2,0,0,0" />
                            </StackPanel>
                        </Border>
                    </Grid>
                    <Border Style="{StaticResource CardBox}" Margin="0,16,0,0">
                        <DockPanel>
                            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                    <CheckBox x:Name="LogErrors" Style="{StaticResource Switch}" Margin="0,0,14,0" Checked="LogFilter_Changed" Unchecked="LogFilter_Changed" ToolTip="L:tip.logErrors"><TextBlock Tag="L:tools.logErrors" FontSize="12" /></CheckBox>
                                    <Button Style="{StaticResource Ghost}" Click="LogRefresh_Click" ToolTip="L:tip.logRefresh"><TextBlock Tag="L:tools.logRefresh" /></Button>
                                </StackPanel>
                                <TextBlock Tag="L:tools.log" Style="{StaticResource H2}" Margin="0" VerticalAlignment="Center" />
                            </DockPanel>
                            <TextBox x:Name="LogView" Height="260" IsReadOnly="True" FontFamily="Consolas" FontSize="11.5" TextWrapping="NoWrap"
                                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Foreground="#FFC4CDD4" />
                        </DockPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- バックアップ -->
            <ScrollViewer x:Name="PageBackups" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="28,0,28,20">
                    <TextBlock Tag="L:bak.title" Style="{StaticResource H1}" />
                    <TextBlock Tag="L:bak.hint" Style="{StaticResource Hint}" Margin="0,0,0,4" />
                    <TextBlock x:Name="BackupsTarget" Style="{StaticResource Hint}" Margin="0,0,0,16" />
                    <StackPanel x:Name="BackupList" />
                    <TextBlock x:Name="NoBackups" Tag="L:bak.none" Style="{StaticResource Hint}" FontSize="14" Margin="0,20" />
                </StackPanel>
            </ScrollViewer>

            <!-- 設定 -->
            <ScrollViewer x:Name="PageSettings" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="28,0,28,20">
                    <TextBlock Tag="L:set.title" Style="{StaticResource H1}" />
                    <TextBlock x:Name="SettingsTarget" Style="{StaticResource Hint}" Margin="0,0,0,16" />
                    <Border Style="{StaticResource CardBox}" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Tag="L:set.game" Style="{StaticResource H2}" />
                            <CheckBox x:Name="SetAccel" Style="{StaticResource Switch}" Click="SetAccel_Click" ToolTip="L:tip.setAccel"><TextBlock Tag="L:set.bootaccel" /></CheckBox>
                            <TextBlock Tag="L:set.bootaccelHint" Style="{StaticResource Hint}" Margin="52,0,0,6" />
                            <CheckBox x:Name="SetConsole" Style="{StaticResource Switch}" Click="SetConsole_Click" ToolTip="L:tip.setConsole"><TextBlock Tag="L:set.console" /></CheckBox>
                            <TextBlock Tag="L:set.consoleHint" Style="{StaticResource Hint}" Margin="52,0,0,0" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CardBox}">
                        <StackPanel>
                            <TextBlock Tag="L:set.installer" Style="{StaticResource H2}" />
                            <CheckBox x:Name="SetClose" Style="{StaticResource Switch}" Click="SetInstaller_Click" ToolTip="L:tip.setClose"><TextBlock Tag="L:set.closeAfterLaunch" /></CheckBox>
                            <CheckBox x:Name="SetCheck" Style="{StaticResource Switch}" Click="SetInstaller_Click" ToolTip="L:tip.setCheck"><TextBlock Tag="L:set.checkUpdate" /></CheckBox>
                            <CheckBox x:Name="SetKeep" Style="{StaticResource Switch}" Click="SetInstaller_Click" ToolTip="L:tip.setKeep"><TextBlock Tag="L:set.keepBackups" /></CheckBox>
                            <Button Style="{StaticResource Ghost}" HorizontalAlignment="Left" Margin="0,8,0,0" Click="Help_Click" ToolTip="L:tip.help"><TextBlock Tag="L:set.tourAgain" /></Button>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- 情報 -->
            <ScrollViewer x:Name="PageAbout" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="28,0,28,20">
                    <TextBlock Tag="L:about.title" Style="{StaticResource H1}" Margin="0,0,0,16" />
                    <Border Style="{StaticResource CardBox}" Margin="0,0,0,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Width="150" Height="150" CornerRadius="16" VerticalAlignment="Top">
                                <Border.Background>
                                    <ImageBrush ImageSource="/mrp-art.jpg" Stretch="UniformToFill" />
                                </Border.Background>
                            </Border>
                            <Grid Grid.Column="1" Margin="22,0,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="160" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Grid.ColumnSpan="2" Text="More Roles Plus" FontSize="22" FontWeight="Black" Foreground="{StaticResource Accent}" Margin="0,0,0,10" />
                                <TextBlock Grid.Row="1" Tag="L:about.version" Style="{StaticResource Hint}" Margin="0,3" />
                                <TextBlock x:Name="AVersion" Grid.Row="1" Grid.Column="1" Margin="0,3" />
                                <TextBlock Grid.Row="2" Tag="L:about.mrp" Style="{StaticResource Hint}" Margin="0,3" />
                                <TextBlock x:Name="AMrp" Grid.Row="2" Grid.Column="1" Margin="0,3" />
                                <TextBlock Grid.Row="3" Tag="L:about.bepinex" Style="{StaticResource Hint}" Margin="0,3" />
                                <TextBlock x:Name="ABepInEx" Grid.Row="3" Grid.Column="1" Margin="0,3" />
                                <TextBlock Grid.Row="4" Tag="L:about.size" Style="{StaticResource Hint}" Margin="0,3" />
                                <TextBlock x:Name="ASize" Grid.Row="4" Grid.Column="1" Margin="0,3" />
                            </Grid>
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource CardBox}" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Tag="L:about.updates" Style="{StaticResource H2}" />
                            <TextBlock Tag="L:about.updatesHint" Style="{StaticResource Hint}" Margin="0,0,0,12" />
                            <WrapPanel>
                                <Button Click="CheckUpdate_Click" Margin="0,0,8,8" ToolTip="L:tip.check"><TextBlock Tag="L:about.check" /></Button>
                                <Button x:Name="BtnSelfUpdate" Style="{StaticResource Primary}" FontSize="13" Padding="16,9" Click="SelfUpdate_Click" Margin="0,0,8,8" Visibility="Collapsed" ToolTip="L:tip.selfUpdate"><TextBlock Tag="L:about.selfUpdate" /></Button>
                                <Button x:Name="BtnDownload" Style="{StaticResource Primary}" FontSize="13" Padding="16,9" Click="Download_Click" Margin="0,0,8,8" Visibility="Collapsed" ToolTip="L:tip.download"><TextBlock Tag="L:about.downloadInstall" /></Button>
                                <Button Style="{StaticResource Ghost}" Click="ReleasePage_Click" Margin="0,0,8,8" ToolTip="L:tip.releasePage"><TextBlock Tag="L:about.releasePage" /></Button>
                                <Button Style="{StaticResource Ghost}" Click="GitHub_Click" Margin="0,0,8,8" ToolTip="L:tip.github"><TextBlock Tag="L:about.github" /></Button>
                            </WrapPanel>
                            <TextBlock x:Name="UpdateText" Margin="0,6,0,0" FontSize="13" />
                            <Border x:Name="NotesBox" Background="#FF12161C" CornerRadius="8" Padding="12,10" Margin="0,10,0,0" Visibility="Collapsed">
                                <TextBlock x:Name="NotesText" FontSize="12" Foreground="#FFC4CDD4" LineHeight="18" />
                            </Border>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CardBox}">
                        <StackPanel>
                            <TextBlock Tag="L:about.credits" Style="{StaticResource H2}" />
                            <TextBlock Tag="L:about.creditText" Style="{StaticResource Hint}" LineHeight="20" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
            </Grid>

            <!-- 下の帯: 進み具合と、マウスを乗せた物の説明 -->
            <Border x:Name="StatusBar" Grid.Row="2" Background="{StaticResource Side}" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="28,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="220" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="StatusIcon" Text="&#xE946;" FontFamily="{StaticResource IconFont}" Foreground="{StaticResource Sub}" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <TextBlock x:Name="Status" Grid.Column="1" Style="{StaticResource Hint}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" VerticalAlignment="Center" />
                    <ProgressBar x:Name="Progress" Grid.Column="2" Maximum="1" VerticalAlignment="Center" Margin="16,0,0,0" />
                </Grid>
            </Border>
        </Grid>
      </Grid>

      <!-- チュートリアル: 暗くした上に、説明する所だけ穴をあけて光らせる -->
      <Grid x:Name="Tour" Visibility="Collapsed" Background="#01000000">
          <Path x:Name="TourShade" Fill="#D0060809" />
          <Border x:Name="TourRing" Width="0" Height="0" Opacity="0" BorderBrush="{StaticResource Accent}" BorderThickness="2" CornerRadius="12" HorizontalAlignment="Left" VerticalAlignment="Top" IsHitTestVisible="False">
              <Border.Effect>
                  <DropShadowEffect x:Name="TourGlow" Color="#FF00E676" BlurRadius="24" ShadowDepth="0" Opacity="0.9" />
              </Border.Effect>
          </Border>
          <Border x:Name="TourCard" Width="380" HorizontalAlignment="Left" VerticalAlignment="Top" Background="{StaticResource Card}" BorderBrush="#6600E676" BorderThickness="1" CornerRadius="14" Padding="22,20">
              <Border.Effect>
                  <DropShadowEffect BlurRadius="30" ShadowDepth="4" Opacity="0.6" />
              </Border.Effect>
              <StackPanel x:Name="TourBodyPanel">
                  <StackPanel.RenderTransform>
                      <TranslateTransform x:Name="TourBodyShift" />
                  </StackPanel.RenderTransform>
                  <Border x:Name="TourArt" Height="150" CornerRadius="10" Margin="0,0,0,14">
                      <Border.Background>
                          <ImageBrush ImageSource="/mrp-art.jpg" Stretch="UniformToFill" Viewbox="0,0.02,1,0.6" ViewboxUnits="RelativeToBoundingBox" />
                      </Border.Background>
                  </Border>
                  <TextBlock x:Name="TourStep" FontSize="11" FontWeight="Bold" Foreground="{StaticResource Accent}" Margin="0,0,0,4" />
                  <TextBlock x:Name="TourTitle" FontSize="18" FontWeight="Bold" Margin="0,0,0,8" />
                  <TextBlock x:Name="TourText" FontSize="13" LineHeight="21" Foreground="#FFCFD8D4" Margin="0,0,0,16" />
                  <DockPanel>
                      <StackPanel x:Name="TourDots" Orientation="Horizontal" VerticalAlignment="Center" />
                      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                          <Button x:Name="TourSkip" Style="{StaticResource Ghost}" Click="TourSkip_Click" Margin="0,0,6,0" Foreground="{StaticResource Sub}"><TextBlock Tag="L:tour.skip" /></Button>
                          <Button x:Name="TourBack" Click="TourBack_Click" Margin="0,0,6,0" Padding="12,7"><TextBlock Tag="L:tour.back" /></Button>
                          <Button x:Name="TourNext" Style="{StaticResource Primary}" Click="TourNext_Click" FontSize="13" Padding="16,7"><TextBlock x:Name="TourNextText" /></Button>
                      </StackPanel>
                  </DockPanel>
              </StackPanel>
          </Border>
      </Grid>
    </Grid>
</Window>
