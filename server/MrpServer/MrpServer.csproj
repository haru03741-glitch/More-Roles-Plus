<Project Sdk="Microsoft.NET.Sdk">
    <!-- Impostor (MRP サーバー) に入れるプラグイン。できた MrpServer.dll を Impostor の plugins フォルダーへ置く -->
    <PropertyGroup>
        <TargetFramework>net8.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <LangVersion>latest</LangVersion>
        <AssemblyName>MrpServer</AssemblyName>
        <RootNamespace>MrpServer</RootNamespace>
        <Version>1.0.0</Version>
        <!-- 0Harmony.dll も出力へ (Impostor の libraries フォルダーへ置く) -->
        <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    </PropertyGroup>
    <ItemGroup>
        <FrameworkReference Include="Microsoft.AspNetCore.App" />
        <!-- Impostor 本体が持っているので出力には入れない -->
        <PackageReference Include="Impostor.Api" Version="1.10.9" ExcludeAssets="runtime" PrivateAssets="all" />
        <!-- ロビーでのモード切り替えの直し (GameModeFix)。0Harmony.dll は Impostor の libraries フォルダーへ置く -->
        <PackageReference Include="Lib.Harmony" Version="2.3.3" />
    </ItemGroup>
</Project>
