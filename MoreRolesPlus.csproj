<Project Sdk="Microsoft.NET.Sdk">
    <!-- AmongUsPath (ゲームのインストール先) は local.props で上書きする。local.props.example を参照。 -->
    <PropertyGroup>
        <AmongUsPath>C:\Program Files\Epic Games\AmongUs</AmongUsPath>
    </PropertyGroup>
    <Import Project="local.props" Condition="Exists('local.props')" />
    <PropertyGroup>
        <TargetFramework Condition="'$(Configuration)' == 'Android'">net10.0</TargetFramework>
        <TargetFramework Condition="'$(Configuration)' != 'Android'">net6.0</TargetFramework>
        <Configurations>Debug;Release;Android</Configurations>
        <LangVersion>preview</LangVersion>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <Optimize>true</Optimize>
        <Nullable>disable</Nullable>
        <AssemblyName>MoreRolesPlus</AssemblyName>
        <RootNamespace>MoreRolesPlus</RootNamespace>
        <Description>More Roles Plus</Description>
        <Platforms>AnyCPU</Platforms>
        <!-- BepInEx はゲーム直下の別ツリー (BepInEx-MRP) に置き、他の mod と plugins を共有しない -->
        <MrpBepInExDir>$(AmongUsPath)\BepInEx-MRP</MrpBepInExDir>
    </PropertyGroup>
    <!-- Android 版は端末上のローダーが生成した core / interop を参照する (NuGet の GameLibs はローダーと版がずれる)。
         置き場は local.props の AndroidBepInExPath で上書きできる。 -->
    <PropertyGroup Condition="'$(Configuration)' == 'Android'">
        <DefineConstants>$(DefineConstants);ANDROID</DefineConstants>
        <AndroidBepInExPath Condition="'$(AndroidBepInExPath)' == ''">..\android-bepinex</AndroidBepInExPath>
    </PropertyGroup>
    <ItemGroup Condition="'$(Configuration)' != 'Android'">
        <PackageReference Include="AmongUs.GameLibs.Steam" Version="2026.9.29" PrivateAssets="all" />
        <PackageReference Include="BepInEx.IL2CPP.MSBuild" Version="2.1.0-rc.1" PrivateAssets="all" />
        <PackageReference Include="BepInEx.Unity.IL2CPP" Version="6.0.0-be.735" Private="false" ExcludeAssets="runtime;native" />
    </ItemGroup>
    <ItemGroup Condition="'$(Configuration)' == 'Android'">
        <Reference Include="$(AndroidBepInExPath)\core\*.dll" Exclude="$(AndroidBepInExPath)\core\Microsoft.*.dll;$(AndroidBepInExPath)\core\System.*.dll" Private="false" />
        <Reference Include="$(AndroidBepInExPath)\interop\*.dll" Private="false" />
    </ItemGroup>
    <!-- シェーダはプラットフォームごとに焼き分けたバンドルを同じ名前で埋め込む -->
    <ItemGroup Condition="'$(Configuration)' != 'Android'">
        <EmbeddedResource Include="Resources\Bundles\mrp_fx.bundle" LogicalName="MoreRolesPlus.Resources.Bundles.mrp_fx.bundle" />
    </ItemGroup>
    <ItemGroup Condition="'$(Configuration)' == 'Android'">
        <EmbeddedResource Include="Resources\Bundles\mrp_fx.android.bundle" LogicalName="MoreRolesPlus.Resources.Bundles.mrp_fx.bundle" />
    </ItemGroup>
    <!-- C++ の部品 (native/src) は本体に埋め込み、起動時に cache へ書き出して読む (別ファイルで配ると入れ忘れ・片方だけの更新が起きる)。
         native/src が出力より新しければビルドの前に組み直す -->
    <PropertyGroup>
        <NativeRid Condition="'$(Configuration)' == 'Android'">android-arm64</NativeRid>
        <NativeRid Condition="'$(Configuration)' != 'Android'">win-x64</NativeRid>
        <NativeFile Condition="'$(Configuration)' == 'Android'">libmrpnative.so</NativeFile>
        <NativeFile Condition="'$(Configuration)' != 'Android'">MrpNative.dll</NativeFile>
        <NativeBinary>$(MSBuildProjectDirectory)/build/native/$(NativeRid)/$(NativeFile)</NativeBinary>
        <NativeSkip Condition="'$(Configuration)' == 'Android'">-SkipPc</NativeSkip>
        <NativeSkip Condition="'$(Configuration)' != 'Android'">-SkipAndroid</NativeSkip>
    </PropertyGroup>
    <ItemGroup>
        <NativeSource Include="native/src/**/*.cpp;native/src/**/*.h;tools/build-native.ps1" />
        <EmbeddedResource Include="$(NativeBinary)" LogicalName="MoreRolesPlus.Native.$(NativeFile)" />
    </ItemGroup>
    <Target Name="BuildNative" BeforeTargets="BeforeBuild" Inputs="@(NativeSource)" Outputs="$(NativeBinary)" Condition="'$(DesignTimeBuild)' != 'true'">
        <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)/tools/build-native.ps1&quot; $(NativeSkip)" />
    </Target>
    <Target Name="RequireNative" BeforeTargets="BeforeBuild" AfterTargets="BuildNative" Condition="'$(DesignTimeBuild)' != 'true'">
        <Error Text="C++ の部品がありません ($(NativeBinary))。tools/build-native.ps1 を回してください" Condition="!Exists('$(NativeBinary)')" />
    </Target>
    <!-- Unity の値型の小さなメソッド (Vector2 の四則・Rect.xMin など) の呼び出しを、コンパイルの直後に mod の中の同じ計算
         (src/Fx/UnityStructs.cs) へ差し替える。interop 経由だと 1 回ごとに il2cpp_runtime_invoke とゲーム側のごみになる -->
    <PropertyGroup>
        <StructInlineDir>$(MSBuildProjectDirectory)/tools/StructInline</StructInlineDir>
        <StructInlineDll>$(StructInlineDir)/bin/Release/net8.0/StructInline.dll</StructInlineDll>
    </PropertyGroup>
    <Target Name="BuildStructInline" BeforeTargets="BeforeBuild" Inputs="$(StructInlineDir)/Program.cs;$(StructInlineDir)/StructInline.csproj" Outputs="$(StructInlineDll)" Condition="'$(DesignTimeBuild)' != 'true'">
        <Exec Command="dotnet build &quot;$(StructInlineDir)/StructInline.csproj&quot; -c Release -v:q -nologo" />
    </Target>
    <Target Name="StructInline" AfterTargets="CoreCompile" Condition="'$(DesignTimeBuild)' != 'true' And '$(StructInline)' != 'false'">
        <WriteLinesToFile File="$(IntermediateOutputPath)structinline.refs" Lines="@(ReferencePath->'%(FullPath)')" Overwrite="true" WriteOnlyWhenDifferent="true" />
        <Exec Command="dotnet &quot;$(StructInlineDll)&quot; &quot;@(IntermediateAssembly->'%(FullPath)')&quot; &quot;$(IntermediateOutputPath)structinline.refs&quot;" />
    </Target>
    <!-- 先に機械語へ訳しておく (ReadyToRun)。起動と試合前の JIT が半分ほどになる。
         ゲームの BepInEx\interop を参照に使うので、MRP が入っているゲームがある時だけ (無ければ IL のまま)。
         interop が作り直されて合わなくなったメソッドは、その時だけ普通に JIT される。MrpReadyToRun=false で切る -->
    <ItemGroup Condition="'$(Configuration)' != 'Android'">
        <PackageDownload Include="Microsoft.NETCore.App.Crossgen2.win-x64" Version="[6.0.36]" />
    </ItemGroup>
    <Target Name="MrpReadyToRun" AfterTargets="CopyFilesToOutputDirectory" BeforeTargets="CopyToGame" Condition="'$(DesignTimeBuild)' != 'true' And '$(Configuration)' != 'Android' And '$(MrpReadyToRun)' != 'false'">
        <ItemGroup>
            <_MrpR2RAll Include="$(AmongUsPath);$(MrpExtraGamePaths)" />
            <!-- MRP が入っているゲームの interop を優先 (その DLL が実際に読み込まれる) -->
            <_MrpR2RRoot Include="@(_MrpR2RAll)" Condition="Exists('%(Identity)\BepInEx\interop\Assembly-CSharp.dll') And Exists('%(Identity)\BepInEx\plugins\$(AssemblyName).dll')" />
            <_MrpR2RRoot Include="@(_MrpR2RAll)" Condition="'@(_MrpR2RRoot)' == '' And Exists('%(Identity)\BepInEx\interop\Assembly-CSharp.dll')" />
        </ItemGroup>
        <PropertyGroup>
            <_MrpR2RGame>@(_MrpR2RRoot->'%(Identity)')</_MrpR2RGame>
            <_MrpR2RGame Condition="$(_MrpR2RGame.Contains(';'))">$(_MrpR2RGame.Split(';')[0])</_MrpR2RGame>
            <_MrpCrossgen>$(NuGetPackageRoot)microsoft.netcore.app.crossgen2.win-x64\6.0.36\tools\crossgen2.exe</_MrpCrossgen>
            <_MrpR2ROut>$(IntermediateOutputPath)r2r\$(AssemblyName).dll</_MrpR2ROut>
        </PropertyGroup>
        <Message Importance="high" Text="ReadyToRun: ゲームの interop が見つからないので IL のまま" Condition="'$(_MrpR2RGame)' == ''" />
        <MakeDir Directories="$(IntermediateOutputPath)r2r" Condition="'$(_MrpR2RGame)' != ''" />
        <Exec Condition="'$(_MrpR2RGame)' != '' And Exists('$(_MrpCrossgen)')" ContinueOnError="true" StandardOutputImportance="low"
              Command="&quot;$(_MrpCrossgen)&quot; &quot;@(IntermediateAssembly->'%(FullPath)')&quot; -o &quot;$(_MrpR2ROut)&quot; --targetos windows --targetarch x64 -O -r &quot;$(_MrpR2RGame)\dotnet\*.dll&quot; -r &quot;$(_MrpR2RGame)\BepInEx\core\*.dll&quot; -r &quot;$(_MrpR2RGame)\BepInEx\interop\*.dll&quot;">
            <Output TaskParameter="ExitCode" PropertyName="_MrpR2RExit" />
        </Exec>
        <!-- obj の IL はそのまま (次のビルドの StructInline は IL にしか使えない)。出力 (bin) の方だけ差し替える -->
        <Copy SourceFiles="$(_MrpR2ROut)" DestinationFiles="$(OutDir)$(TargetFileName)" Condition="'$(_MrpR2RExit)' == '0' And Exists('$(_MrpR2ROut)')" />
        <Delete Files="$(_MrpR2ROut)" />
        <Message Importance="high" Text="ReadyToRun: 機械語つき ($(_MrpR2RGame))" Condition="'$(_MrpR2RExit)' == '0'" />
        <Warning Text="ReadyToRun に失敗したので IL のまま配る" Condition="'$(_MrpR2RExit)' != '' And '$(_MrpR2RExit)' != '0'" />
    </Target>
    <!-- 設定画面の見出し用のフォント (SIL OFL 1.1・JIS 第一水準までに削ったもの) -->
    <ItemGroup>
        <EmbeddedResource Include="Resources\Fonts\MochiyPopOne-Regular.ttf" LogicalName="MoreRolesPlus.Resources.Fonts.MochiyPopOne-Regular.ttf" />
    </ItemGroup>
    <ItemGroup>
        <Compile Remove="tools\**;unity\**;patcher\**" />
    </ItemGroup>
    <!-- 配る DLL (MrpPublicBuild=true) は公開しているソースだけで組む -->
    <ItemGroup Condition="'$(MrpPublicBuild)' == 'true'">
        <Compile Remove="src\Bridge\TestBridge.Host.cs" />
    </ItemGroup>
    <!-- 能力ボタンの絵 -->
    <ItemGroup>
        <EmbeddedResource Include="Resources\Icons\*.png" LogicalName="MoreRolesPlus.Resources.Icons.%(Filename)%(Extension)" />
        <EmbeddedResource Include="Resources\Illus\*.jpg" LogicalName="MoreRolesPlus.Resources.Illus.%(Filename)%(Extension)" />
        <EmbeddedResource Include="Resources\Cinema\*.*" LogicalName="MoreRolesPlus.Resources.Cinema.%(Filename)%(Extension)" />
        <!-- 画面に出す文 (言語ごと・遊ぶ人は BepInEx/config/MoreRolesPlus/Language で書き換えられる) -->
        <EmbeddedResource Include="Resources\Lang\*.dat" LogicalName="MoreRolesPlus.Resources.Lang.%(Filename)%(Extension)" />
        <!-- 床マスクはゲームの絵から tools/make-floor-mask.py で作る (リポジトリには入れない・無ければ当たり判定で切る) -->
        <EmbeddedResource Include="Resources\FloorMasks\*.bin" LogicalName="MoreRolesPlus.Resources.FloorMasks.%(Filename)%(Extension)" />
        <EmbeddedResource Include="Resources\Heights\*.bin" LogicalName="MoreRolesPlus.Resources.Heights.%(Filename)%(Extension)" />
        <EmbeddedResource Include="Resources\WaterOpen\*.bin" LogicalName="MoreRolesPlus.Resources.WaterOpen.%(Filename)%(Extension)" />
        <EmbeddedResource Include="Resources\WaterBarrier\*.bin" LogicalName="MoreRolesPlus.Resources.WaterBarrier.%(Filename)%(Extension)" />
    </ItemGroup>
    <!-- 床マスクが欠けたまま配る DLL を作らないように (欠けたマップは水が壁の上にはみ出す古い見え方になる) -->
    <Target Name="WarnFloorMasks" BeforeTargets="BeforeBuild" Condition="'$(DesignTimeBuild)' != 'true'">
        <ItemGroup>
            <_MrpFloorMask Include="Resources\FloorMasks\*.bin" />
        </ItemGroup>
        <Warning Code="MRP001" Text="Resources\FloorMasks の床マスクが @(_MrpFloorMask->Count()) 枚しかありません (5 マップ分要る)。tools/make-floor-mask.py で作るか、作ってある所から写してください" Condition="@(_MrpFloorMask->Count()) &lt; 5" />
    </Target>
    <!-- 配置先は AmongUsPath と、local.props の MrpExtraGamePaths (; 区切り・Epic 版と Steam 版の両方へ置く時など)。
         BepInEx-MRP\core がある所は BepInEx-MRP\plugins へ。無くても、普通の BepInEx\plugins に MRP が入っている所はそこへ
         (他の mod の BepInEx に勝手に入れないよう、MRP が既にある時だけ)。MrpNoDeploy=true で配置しない。 -->
    <Target Name="CopyToGame" AfterTargets="Build" Condition="'$(Configuration)' != 'Android' And '$(MrpNoDeploy)' != 'true'">
        <ItemGroup>
            <_MrpGameRoot Include="$(AmongUsPath);$(MrpExtraGamePaths)" />
            <_MrpRootMrp Include="@(_MrpGameRoot)" Condition="Exists('%(Identity)\BepInEx-MRP\core')" />
            <_MrpRootPlain Include="@(_MrpGameRoot)" Condition="!Exists('%(Identity)\BepInEx-MRP\core') And Exists('%(Identity)\BepInEx\plugins\$(AssemblyName).dll')" />
            <_MrpPluginDir Include="@(_MrpRootMrp->'%(Identity)\BepInEx-MRP\plugins')" />
            <_MrpPluginDir Include="@(_MrpRootPlain->'%(Identity)\BepInEx\plugins')" />
        </ItemGroup>
        <RemoveDuplicates Inputs="@(_MrpPluginDir)">
            <Output TaskParameter="Filtered" ItemName="_MrpPluginDirUnique" />
        </RemoveDuplicates>
        <MakeDir Directories="@(_MrpPluginDirUnique)" />
        <Copy SourceFiles="$(OutputPath)$(AssemblyName).dll" DestinationFolder="%(_MrpPluginDirUnique.Identity)\" ContinueOnError="WarnAndContinue" Condition="'@(_MrpPluginDirUnique)' != ''" />
        <Copy SourceFiles="$(OutputPath)$(AssemblyName).pdb" DestinationFolder="%(_MrpPluginDirUnique.Identity)\" Condition="'@(_MrpPluginDirUnique)' != '' And Exists('$(OutputPath)$(AssemblyName).pdb')" ContinueOnError="WarnAndContinue" />
        <!-- C++ の部品は本体に入ったので、前に別ファイルで置いた物は消す -->
        <Delete Files="@(_MrpPluginDirUnique->'%(Identity)\MrpNative.dll')" ContinueOnError="WarnAndContinue" />
        <!-- ゲームが DLL を掴んでいると Copy は警告だけで古い DLL が残るので、置いた物の中身を見比べる -->
        <GetFileHash Files="$(OutputPath)$(AssemblyName).dll" Condition="'@(_MrpPluginDirUnique)' != ''">
            <Output TaskParameter="Hash" PropertyName="_MrpBuiltHash" />
        </GetFileHash>
        <ItemGroup>
            <_MrpPlaced Include="@(_MrpPluginDirUnique->'%(Identity)\$(AssemblyName).dll')" />
        </ItemGroup>
        <GetFileHash Files="@(_MrpPlaced)" Condition="'@(_MrpPlaced)' != ''" ContinueOnError="WarnAndContinue">
            <Output TaskParameter="Items" ItemName="_MrpPlacedHash" />
        </GetFileHash>
        <Message Importance="high" Text="配置済み: %(_MrpPlacedHash.Identity)" Condition="'@(_MrpPlacedHash)' != '' And '%(_MrpPlacedHash.FileHash)' == '$(_MrpBuiltHash)'" />
        <Warning Text="配置できていない (古い DLL のまま・ゲームが起動中なら閉じてビルドし直す): %(_MrpPlacedHash.Identity)" Condition="'@(_MrpPlacedHash)' != '' And '%(_MrpPlacedHash.FileHash)' != '$(_MrpBuiltHash)'" />
    </Target>
    <!-- Android: ランチャーの APK が DLL を同梱し、端末の BepInEx/plugins と違う時だけ入れ直す。
         横の .properties (DLL の SHA-256 と版) がランチャーの見比べる目印。 -->
    <PropertyGroup Condition="'$(Configuration)' == 'Android'">
        <AndroidApkAssetsDir Condition="'$(AndroidApkAssetsDir)' == ''">$(MSBuildProjectDirectory)\build-android\apk-assets\plugins\</AndroidApkAssetsDir>
    </PropertyGroup>
    <Target Name="AndroidApkAssets" AfterTargets="Build" Condition="'$(Configuration)' == 'Android'">
        <GetAssemblyIdentity AssemblyFiles="$(TargetPath)">
            <Output TaskParameter="Assemblies" ItemName="_PluginAssemblyIdentity" />
        </GetAssemblyIdentity>
        <PropertyGroup>
            <_PluginVersion>%(_PluginAssemblyIdentity.Version)</_PluginVersion>
        </PropertyGroup>
        <GetFileHash Files="$(TargetPath)" Algorithm="SHA256" HashEncoding="hex">
            <Output TaskParameter="Hash" PropertyName="_PluginSha256" />
        </GetFileHash>
        <MakeDir Directories="$(AndroidApkAssetsDir)" />
        <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(AndroidApkAssetsDir)" />
        <WriteLinesToFile File="$(AndroidApkAssetsDir)$(AssemblyName).dll.properties" Overwrite="true" Lines="version=$(_PluginVersion);sha256=$([System.String]::Copy('$(_PluginSha256)').ToLowerInvariant())" />
        <!-- C++ の部品は本体に入ったので、前に別ファイルで入れていた物は APK から外す -->
        <Delete Files="$(AndroidApkAssetsDir)libmrpnative.so;$(AndroidApkAssetsDir)libmrpnative.so.properties" />
    </Target>
</Project>
