<Project Sdk="Microsoft.NET.Sdk">
    <!-- AmongUsPath (ゲームのインストール先) は local.props で上書きする。local.props.example を参照。 -->
    <PropertyGroup>
        <AmongUsPath>C:\Program Files\Epic Games\AmongUs</AmongUsPath>
    </PropertyGroup>
    <Import Project="local.props" Condition="Exists('local.props')" />
    <PropertyGroup>
        <TargetFramework Condition="'$(Configuration)' == 'Android'">net10.0</TargetFramework>
        <TargetFramework Condition="'$(Configuration)' != 'Android'">net6.0</TargetFramework>
        <Configurations>Debug;Release;Android</Configurations>
        <LangVersion>preview</LangVersion>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <Optimize>true</Optimize>
        <Nullable>disable</Nullable>
        <AssemblyName>MoreRolesPlus</AssemblyName>
        <RootNamespace>MoreRolesPlus</RootNamespace>
        <Description>More Roles Plus</Description>
        <Platforms>AnyCPU</Platforms>
        <!-- BepInEx はゲーム直下の別ツリー (BepInEx-MRP) に置き、他の mod と plugins を共有しない -->
        <MrpBepInExDir>$(AmongUsPath)\BepInEx-MRP</MrpBepInExDir>
    </PropertyGroup>
    <!-- Android 版は端末上のローダーが生成した core / interop を参照する (NuGet の GameLibs はローダーと版がずれる)。
         置き場は local.props の AndroidBepInExPath で上書きできる。 -->
    <PropertyGroup Condition="'$(Configuration)' == 'Android'">
        <DefineConstants>$(DefineConstants);ANDROID</DefineConstants>
        <AndroidBepInExPath Condition="'$(AndroidBepInExPath)' == ''">..\android-bepinex</AndroidBepInExPath>
    </PropertyGroup>
    <ItemGroup Condition="'$(Configuration)' != 'Android'">
        <PackageReference Include="AmongUs.GameLibs.Steam" Version="2026.9.29" PrivateAssets="all" />
        <PackageReference Include="BepInEx.IL2CPP.MSBuild" Version="2.1.0-rc.1" PrivateAssets="all" />
        <PackageReference Include="BepInEx.Unity.IL2CPP" Version="6.0.0-be.735" Private="false" ExcludeAssets="runtime;native" />
    </ItemGroup>
    <ItemGroup Condition="'$(Configuration)' == 'Android'">
        <Reference Include="$(AndroidBepInExPath)\core\*.dll" Exclude="$(AndroidBepInExPath)\core\Microsoft.*.dll;$(AndroidBepInExPath)\core\System.*.dll" Private="false" />
        <Reference Include="$(AndroidBepInExPath)\interop\*.dll" Private="false" />
    </ItemGroup>
    <!-- シェーダはプラットフォームごとに焼き分けたバンドルを同じ名前で埋め込む -->
    <ItemGroup Condition="'$(Configuration)' != 'Android'">
        <EmbeddedResource Include="Resources\Bundles\mrp_fx.bundle" LogicalName="MoreRolesPlus.Resources.Bundles.mrp_fx.bundle" />
    </ItemGroup>
    <ItemGroup Condition="'$(Configuration)' == 'Android'">
        <EmbeddedResource Include="Resources\Bundles\mrp_fx.android.bundle" LogicalName="MoreRolesPlus.Resources.Bundles.mrp_fx.bundle" />
    </ItemGroup>
    <!-- 設定画面の見出し用のフォント (SIL OFL 1.1・JIS 第一水準までに削ったもの) -->
    <ItemGroup>
        <EmbeddedResource Include="Resources\Fonts\MochiyPopOne-Regular.ttf" LogicalName="MoreRolesPlus.Resources.Fonts.MochiyPopOne-Regular.ttf" />
    </ItemGroup>
    <ItemGroup>
        <Compile Remove="tools\**;unity\**;patcher\**" />
    </ItemGroup>
    <!-- 能力ボタンの絵 (tools/make-button-icons.py で描く) -->
    <ItemGroup>
        <EmbeddedResource Include="Resources\Icons\*.png" LogicalName="MoreRolesPlus.Resources.Icons.%(Filename)%(Extension)" />
        <!-- 床マスクはゲームの絵から tools/make-floor-mask.py で作る (リポジトリには入れない・無ければ当たり判定で切る) -->
        <EmbeddedResource Include="Resources\FloorMasks\*.bin" LogicalName="MoreRolesPlus.Resources.FloorMasks.%(Filename)%(Extension)" />
        <EmbeddedResource Include="Resources\Heights\*.bin" LogicalName="MoreRolesPlus.Resources.Heights.%(Filename)%(Extension)" />
        <EmbeddedResource Include="Resources\WaterOpen\*.bin" LogicalName="MoreRolesPlus.Resources.WaterOpen.%(Filename)%(Extension)" />
        <EmbeddedResource Include="Resources\WaterBarrier\*.bin" LogicalName="MoreRolesPlus.Resources.WaterBarrier.%(Filename)%(Extension)" />
    </ItemGroup>
    <Target Name="CopyToGame" AfterTargets="Build" Condition="'$(Configuration)' != 'Android' And Exists('$(MrpBepInExDir)\core')">
        <MakeDir Directories="$(MrpBepInExDir)\plugins" />
        <Copy SourceFiles="$(OutputPath)$(AssemblyName).dll" DestinationFolder="$(MrpBepInExDir)\plugins\" ContinueOnError="WarnAndContinue" />
        <Copy SourceFiles="$(OutputPath)$(AssemblyName).pdb" DestinationFolder="$(MrpBepInExDir)\plugins\" Condition="Exists('$(OutputPath)$(AssemblyName).pdb')" ContinueOnError="WarnAndContinue" />
        <!-- C++ の部品 (tools/build-native.ps1 で組んだ物があれば) -->
        <Copy SourceFiles="$(MSBuildProjectDirectory)/build/native/win-x64/MrpNative.dll" DestinationFolder="$(MrpBepInExDir)/plugins/" Condition="Exists('$(MSBuildProjectDirectory)/build/native/win-x64/MrpNative.dll')" SkipUnchangedFiles="true" ContinueOnError="WarnAndContinue" />
    </Target>
    <!-- Android: ランチャーの APK が DLL を同梱し、端末の BepInEx/plugins と違う時だけ入れ直す。
         横の .properties (DLL の SHA-256 と版) がランチャーの見比べる目印。 -->
    <PropertyGroup Condition="'$(Configuration)' == 'Android'">
        <AndroidApkAssetsDir Condition="'$(AndroidApkAssetsDir)' == ''">$(MSBuildProjectDirectory)\build-android\apk-assets\plugins\</AndroidApkAssetsDir>
    </PropertyGroup>
    <Target Name="AndroidApkAssets" AfterTargets="Build" Condition="'$(Configuration)' == 'Android'">
        <GetAssemblyIdentity AssemblyFiles="$(TargetPath)">
            <Output TaskParameter="Assemblies" ItemName="_PluginAssemblyIdentity" />
        </GetAssemblyIdentity>
        <PropertyGroup>
            <_PluginVersion>%(_PluginAssemblyIdentity.Version)</_PluginVersion>
        </PropertyGroup>
        <GetFileHash Files="$(TargetPath)" Algorithm="SHA256" HashEncoding="hex">
            <Output TaskParameter="Hash" PropertyName="_PluginSha256" />
        </GetFileHash>
        <MakeDir Directories="$(AndroidApkAssetsDir)" />
        <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(AndroidApkAssetsDir)" />
        <WriteLinesToFile File="$(AndroidApkAssetsDir)$(AssemblyName).dll.properties" Overwrite="true" Lines="version=$(_PluginVersion);sha256=$([System.String]::Copy('$(_PluginSha256)').ToLowerInvariant())" />
        <!-- C++ の部品 (tools/build-native.ps1 で組む)。ランチャーが DLL と同じ目印で入れる。無いと地形が動かないので止める -->
        <PropertyGroup>
            <_NativeSo>$(MSBuildProjectDirectory)/build/native/android-arm64/libmrpnative.so</_NativeSo>
        </PropertyGroup>
        <Error Text="libmrpnative.so がありません。先に tools/build-native.ps1 を回してください ($(_NativeSo))" Condition="!Exists('$(_NativeSo)')" />
        <GetFileHash Files="$(_NativeSo)" Algorithm="SHA256" HashEncoding="hex" Condition="Exists('$(_NativeSo)')">
            <Output TaskParameter="Hash" PropertyName="_NativeSha256" />
        </GetFileHash>
        <Copy SourceFiles="$(_NativeSo)" DestinationFolder="$(AndroidApkAssetsDir)" Condition="Exists('$(_NativeSo)')" />
        <WriteLinesToFile File="$(AndroidApkAssetsDir)libmrpnative.so.properties" Overwrite="true" Lines="version=$(_PluginVersion);sha256=$([System.String]::Copy('$(_NativeSha256)').ToLowerInvariant())" Condition="Exists('$(_NativeSo)')" />
    </Target>
</Project>
